---
layout: base.njk
title: "Liên hệ"
description: "Kết nối với tôi qua email, LinkedIn hoặc mạng xã hội."
permalink: "/lien-he/index.html"
---
<section>
  <div class="wrap prose">
    <h1 class="section-title" style="font-size:2.1rem">Liên hệ</h1>
    <p class="section-sub">Rất vui được kết nối — về công việc, hợp tác hay đơn giản là trao đổi ý tưởng.</p>

    <div class="contact-grid">
      {% if site.email %}
      <div class="contact-card">
        <div class="ico">✉️</div><h3>Email</h3>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      </div>
      {% endif %}
      {% if site.linkedin %}
      <div class="contact-card">
        <div class="ico">💼</div><h3>LinkedIn</h3>
        <a href="{{ site.linkedin }}" target="_blank" rel="noopener">Kết nối</a>
      </div>
      {% endif %}
      {% if site.facebook %}
      <div class="contact-card">
        <div class="ico">📘</div><h3>Facebook</h3>
        <a href="{{ site.facebook }}" target="_blank" rel="noopener">Theo dõi</a>
      </div>
      {% endif %}
      {% if site.github %}
      <div class="contact-card">
        <div class="ico">💻</div><h3>GitHub</h3>
        <a href="{{ site.github }}" target="_blank" rel="noopener">Xem dự án</a>
      </div>
      {% endif %}
    </div>

    <h2 style="margin-top:36px">Gửi tin nhắn</h2>
    <!-- Form gửi qua Netlify (hoạt động sau khi deploy lên Netlify) -->
    <form name="lienhe" method="POST" data-netlify="true" netlify-honeypot="bot-field" style="display:grid;gap:12px;max-width:520px">
      <input type="hidden" name="form-name" value="lienhe">
      <p style="display:none"><label>Bỏ trống: <input name="bot-field"></label></p>
      <input type="text" name="hoten" placeholder="Họ và tên" required style="padding:11px;border:1px solid var(--border);border-radius:8px;background:var(--card);color:var(--text)">
      <input type="email" name="email" placeholder="Email của bạn" required style="padding:11px;border:1px solid var(--border);border-radius:8px;background:var(--card);color:var(--text)">
      <textarea name="noidung" rows="5" placeholder="Nội dung..." style="padding:11px;border:1px solid var(--border);border-radius:8px;background:var(--card);color:var(--text)"></textarea>
      <button type="submit" class="btn" style="cursor:pointer">Gửi</button>
    </form>
  </div>
</section>
