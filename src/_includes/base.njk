<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{% if site.googleVerify %}<meta name="google-site-verification" content="{{ site.googleVerify }}">{% endif %}
<title>{% if seo.metaTitle %}{{ seo.metaTitle }}{% elif title %}{{ title }} — {{ site.brand }}{% else %}{{ site.authorName }} — {{ site.authorTitle }}{% endif %}</title>
<meta name="description" content="{{ seo.metaDescription or description or excerpt or site.tagline }}">
{% if seo.keywords %}<meta name="keywords" content="{{ seo.keywords | join(', ') }}">{% endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="{% if layout == 'post.njk' %}article{% else %}website{% endif %}">
<meta property="og:title" content="{% if seo.metaTitle %}{{ seo.metaTitle }}{% elif title %}{{ title }}{% else %}{{ site.authorName }}{% endif %}">
<meta property="og:description" content="{{ seo.metaDescription or description or excerpt or site.tagline }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
{% if cover %}<meta property="og:image" content="{{ site.url }}{{ cover }}">{% endif %}
<link rel="stylesheet" href="/css/style.css">
<!-- Tránh nháy sáng khi tải ở chế độ tối -->
<script>(function(){var t=localStorage.getItem("theme");if(t)document.documentElement.setAttribute("data-theme",t);})();</script>
</head>
<body>

<header>
  <div class="wrap top-bar">
    <a href="/" class="logo">{{ site.brand }}</a>
    <nav class="menu">
      <a href="/">Trang chủ</a>
      <a href="/ve-toi/">Về tôi</a>
      <a href="/bai-viet/">Bài viết</a>
      <a href="/du-an/">Dự án</a>
      <a href="/ghi-chu/">Ghi chú</a>
      <a href="/lien-he/">Liên hệ</a>
    </nav>
    <button class="theme-toggle" aria-label="Đổi chế độ sáng/tối">🌙</button>
    <button class="hamburger" aria-label="Mở menu">☰</button>
  </div>
</header>

{{ content | safe }}

<footer>
  <div class="wrap">
    <div class="social">
      {% if site.linkedin %}<a href="{{ site.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>{% endif %}
      {% if site.facebook %}<a href="{{ site.facebook }}" target="_blank" rel="noopener">Facebook</a>{% endif %}
      {% if site.github %}<a href="{{ site.github }}" target="_blank" rel="noopener">GitHub</a>{% endif %}
      {% if site.email %}<a href="mailto:{{ site.email }}">Email</a>{% endif %}
    </div>
    © 2026 {{ site.authorName }} · {{ site.authorTitle }}
  </div>
</footer>

<script src="/js/main.js"></script>
</body>
</html>
